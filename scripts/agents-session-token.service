[Unit]
Description=Load the Agents service account from 1Password into the desktop session
Wants=app-com.onepassword.OnePassword@autostart.service
After=graphical-session.target app-com.onepassword.OnePassword@autostart.service
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Let the desktop app initialize its CLI integration after process startup.
ExecStartPre=/usr/bin/sleep 3
ExecStart=%h/bin/agents-session-unlock
ExecStop=/usr/bin/systemctl --user unset-environment OP_SERVICE_ACCOUNT_TOKEN
TimeoutStartSec=150
