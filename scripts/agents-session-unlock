#!/bin/bash
# Never trace credentials, including when invoked with bash -x.
set +x
set -euo pipefail

fail() {
  printf '%s\n' "$1" >&2
  notify-send '1Password Agents access' "$1" || true
  exit 1
}

# Bootstrap using the desktop app, not an inherited service-account identity.
unset OP_SERVICE_ACCOUNT_TOKEN OP_CONNECT_HOST OP_CONNECT_TOKEN OP_ACCOUNT
export OP_BIOMETRIC_UNLOCK_ENABLED=true
OP_SERVICE_ACCOUNT_TOKEN=$(timeout 120s /usr/bin/op read \
  'op://Private/Service Account Auth Token for Agents/credential' 2>/dev/null) ||
  fail 'Unlock 1Password, then run: systemctl --user restart agents-session-token.service'
[[ -n $OP_SERVICE_ACCOUNT_TOKEN ]] || fail 'The Agents service-account token is empty.'
export OP_SERVICE_ACCOUNT_TOKEN

/usr/bin/op vault get Agents >/dev/null 2>&1 ||
  fail 'The service-account token could not access Agents.'

# UWSM exports the value and records only its name for session-end cleanup.
# Suppress output even if UWSM debug logging is enabled in the environment.
uwsm finalize OP_SERVICE_ACCOUNT_TOKEN >/dev/null 2>&1 ||
  fail 'Could not publish the token to the graphical session.'
unset OP_SERVICE_ACCOUNT_TOKEN
printf 'Agents token loaded into the desktop session.\n'
